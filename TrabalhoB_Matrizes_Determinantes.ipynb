    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Determinante da Matriz Triangular (NumPy): 1350.00\n",
      "Produto da Diagonal Principal: 1350.00\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Definição das Matrizes\n",
    "A_base = np.random.randint(1, 10, (4, 4))\n",
    "T = np.triu(A_base)  # Matriz Triangular Superior\n",
    "\n",
    "matrizes = {\n",
    "    'Triangular Superior': T,\n",
    "    'Identidade': np.eye(4),\n",
    "    'Aleatória': np.random.randint(0, 10, (4, 4))\n",
    "}\n",
    "\n",
    "# 2. Visualização usando Matplotlib Puro\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "\n",
    "for ax, (nome, mat) in zip(axes, matrizes.items()):\n",
    "    im = ax.imshow(mat, cmap='Blues')\n",
    "    ax.set_title(nome, fontsize=12, fontweight='bold')\n",
    "    \n",
    "    # Adicionando os números dentro dos quadrados\n",
    "    for i in range(mat.shape[0]):\n",
    "        for j in range(mat.shape[1]):\n",
    "            ax.text(j, i, int(mat[i, j]), ha=\"center\", va=\"center\", color=\"black\")\n",
    "    \n",
    "    ax.set_xticks([]) # Remove os eixos para ficar mais limpo\n",
    "    ax.set_yticks([])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 3. Validação Teórica (Propriedade de Boldrini)\n",
    "det_T = np.linalg.det(T)\n",
    "diagonal_prod = np.prod(np.diag(T))\n",
    "\n",
    "print(f\"Determinante da Matriz Triangular (NumPy): {det_T:.2f}\")\n",
    "print(f\"Produto da Diagonal Principal: {diagonal_prod:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9a7bdf01",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "# 4. Aplicações Práticas\n",
    "\n",
    "## 4.1 Sistemas Lineares — Regra de Cramer\n",
    "\n",
    "A Regra de Cramer usa determinantes para resolver sistemas lineares do tipo $A\\vec{x} = \\vec{b}$, se $\\det(A) \\neq 0$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "9b28e0de",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(np.float64(1.4285714285714282), np.float64(1.857142857142857))"
      ]
     },
     "execution_count": 53,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "A = np.array([[2, -1], [1, 3]])\n",
    "b = np.array([1, 7])\n",
    "\n",
    "D = np.linalg.det(A)\n",
    "A1 = A.copy(); A1[:,0] = b\n",
    "A2 = A.copy(); A2[:,1] = b\n",
    "D1 = np.linalg.det(A1)\n",
    "D2 = np.linalg.det(A2)\n",
    "x1 = D1 / D\n",
    "x2 = D2 / D\n",
    "x1, x2"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "218170e7",
   "metadata": {},
   "source": [
    "## 4.2 Área e Volume\n",
    "\n",
    "O determinante de uma matriz $2 \\times 2$ representa a área do paralelogramo formado pelos vetores colunas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "id": "c1e12771",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "np.float64(5.000000000000001)"
      ]
     },
     "execution_count": 54,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "v1 = np.array([3, 1])\n",
    "v2 = np.array([1, 2])\n",
    "M = np.column_stack([v1, v2])\n",
    "area = abs(np.linalg.det(M))\n",
    "area"
   ]
  }
